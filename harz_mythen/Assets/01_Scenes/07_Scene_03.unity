  - {fileID: 21300000, guid: cda7ade85fe6511468d976fb5364f39b, type: 3}
  RumaSpeechbubble: {fileID: 21300000, guid: ac0a842073fcde5429ba1b2c6a8761dd, type: 3}
  imageChangeRomar: {fileID: 301048029}
  spriteChoicesRomar_1:
  - {fileID: 21300000, guid: c4a9670a5102dd94bbf1018aebebc1cc, type: 3}
  - {fileID: 21300000, guid: f97e839621691884880b67bbc378cd4d, type: 3}
  - {fileID: 21300000, guid: a97eb140270d0e44d8bb187af4026c82, type: 3}
  - {fileID: 21300000, guid: 540a973d9c900504f96595d35727e59e, type: 3}
  - {fileID: 21300000, guid: ab385d8daf747c84f9072b765d0698f5, type: 3}
  - {fileID: 21300000, guid: c4a9670a5102dd94bbf1018aebebc1cc, type: 3}
  - {fileID: 21300000, guid: f97e839621691884880b67bbc378cd4d, type: 3}
  spriteChoicesRomar_2:
  - {fileID: 21300000, guid: a97eb140270d0e44d8bb187af4026c82, type: 3}
  - {fileID: 21300000, guid: 540a973d9c900504f96595d35727e59e, type: 3}
  - {fileID: 21300000, guid: ab385d8daf747c84f9072b765d0698f5, type: 3}
  - {fileID: 21300000, guid: c4a9670a5102dd94bbf1018aebebc1cc, type: 3}
  - {fileID: 21300000, guid: f97e839621691884880b67bbc378cd4d, type: 3}
  RomarSpeechbubble: {fileID: 21300000, guid: 540a973d9c900504f96595d35727e59e, type: 3}
  lines:
  - "Nun bin ich schon frei und doch an das Wasser gebunden. Mich d\xFCnkt, Romar
    und ich werden niemals wieder vereint sein."
  - "Meine liebste Ruma, wo magst du nur sein? Unerl\xE4sslich suche ich dich, doch
    scheint keine Spur zu dir zu f\xFChren."
  - Wie kann es nur sein, dass ich dich in allen Landen dieser Welt nicht finden
    kann?
  - "Wenn ich dich nicht finden kann, so m\xF6chte ich mich hier setzen und trauern."
  - "Ach, nun sehe ich schon Schatten und Schemen \xFCber dem Wasser, die mich glauben
    lassen, mein Romar w\xE4re wieder bei mir."
  - Wie sehr ich ihn vermissen muss, dass meine Augen mir solch einen Streich spielen!
  - "Wenn ich dich nicht erreichen kann, so m\xF6chte ich mich legen und trauern."
  textSpeed: 0.03
  lines2:
  - "Kann es denn wirklich sein\u2026? Darf ich meinen Augen trauen?!"
  - "Romar! Kein Zweifel, du bist es! Den Sternen sei Dank, wir haben uns zur\xFCck."
  - "Oh meine Ruma, du siehst so ver\xE4ndert aus! Und doch habe ich keinen Zweifel,
    dass du dieselbe bist, in die ich mich so unsterblich verliebt habe."
  - "Endlich sind wieder vereint. Dieses Mal soll es f\xFCr die Ewigkeit sein."
  - Ja, mein Liebling. Nie wieder werde ich von deiner Seite weichen.
  wall: {fileID: 1633686546}
  mainCamera: {fileID: 1750940343}
  Button: {fileID: 1705351521}
